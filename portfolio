        :root {
            --primary: #2563eb;
            --bg-light: #f8fafc;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --glass: rgba(255, 255, 255, 0.9);
            --card-shadow: 0 10px 30px rgba(0,0,0,0.04);
            --transition: all 0.3s ease;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: var(--bg-light); color: var(--text-main); line-height: 1.6; }
        .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }

        /* Navigation */
        nav { padding: 1.5rem 0; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; background: var(--glass); backdrop-filter: blur(10px); z-index: 100; border-bottom: 1px solid #e2e8f0; }
        .nav-links a { text-decoration: none; color: var(--text-main); margin-left: 2rem; font-weight: 500; font-size: 0.9rem; transition: var(--transition); }
        .nav-links a:hover { color: var(--primary); }
        .btn-hire { background: var(--primary); color: white !important; padding: 0.6rem 1.2rem; border-radius: 8px; }

        /* Hero Section */
        .hero { padding: 8rem 0 5rem; display: flex; align-items: center; gap: 4rem; }
        .hero-content { flex: 1; }
        .badge-main { color: var(--primary); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 1rem; display: block; }
        .hero h1 { font-size: 3.5rem; line-height: 1.2; margin-bottom: 1.5rem; }
        .hero h1 span { color: var(--primary); }
        .hero p { font-size: 1.1rem; color: var(--text-muted); margin-bottom: 2rem; max-width: 600px; }
        
        /* Animated Hero Visual */
        .hero-visual { 
            width: 350px; 
            height: 350px; 
            background: linear-gradient(135deg, #2563eb, #7cc0ff); 
            border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; 
            position: relative; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(37, 99, 235, 0.3); 
            animation: floatGlow 6s ease-in-out infinite;
        }

        .hero-visual img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            mix-blend-mode: screen; 
            filter: brightness(1.1) contrast(1.1);
        }

        /* The "Breathing" Animation */
        @keyframes floatGlow {
            0%, 100% { 
                transform: translateY(0) scale(1);
                box-shadow: 0 20px 40px rgba(37, 99, 235, 0.3);
                border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
            }
            50% { 
                transform: translateY(-15px) scale(1.02);
                box-shadow: 0 35px 60px rgba(37, 99, 235, 0.5);
                border-radius: 40% 60% 60% 40% / 40% 40% 60% 60%;
            }
        }

        /* Sections */
        section { padding: 5rem 0; }
        h2 { font-size: 2.2rem; margin-bottom: 3rem; }

        /* Experience & Project Cards */
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; }
        .card { background: white; padding: 2rem; border-radius: 16px; border: 1px solid #f1f5f9; box-shadow: var(--card-shadow); transition: var(--transition); }
        .card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.08); }
        .card h3 { margin: 1rem 0 0.5rem; font-size: 1.3rem; }
        .card .company { color: var(--primary); font-weight: 600; font-size: 0.9rem; margin-bottom: 1rem; display: block; }
        
        /* Skill Badges */
        .skill-group { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1rem; }
        .skill-tag { background: #eff6ff; color: var(--primary); padding: 0.5rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 500; border: 1px solid #dbeafe; }

        footer { background: #0f172a; color: white; padding: 5rem 0; text-align: center; }
        .footer-email { font-size: 1.8rem; color: white; text-decoration: none; border-bottom: 2px solid var(--primary); }
        .footer-link { color: #94a3b8; text-decoration: none; margin: 0 1.5rem; transition: var(--transition); font-size: 0.9rem; }
        .footer-link:hover { color: white; }

        @media (max-width: 768px) {
            .hero { flex-direction: column; text-align: center; padding: 4rem 0; }
            .hero h1 { font-size: 2.5rem; }
            .hero-visual { width: 280px; height: 280px; }
        }
    </style>
